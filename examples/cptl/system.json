{
  "system": "cptl",
  "title": "Parity and a strict resource budget on a path with recorded precedence",
  "abstractions": ["route", "adapt", "suffix"],
  "constants": {
    "GUARDS": [true, false, true, true, false, true]
  },
  "types": {
    "Row": {
      "record": {"stage": "integer", "best": {"list": "integer"}, "count": {"list": "integer"}}
    },
    "Step": {
      "record": {
        "stage": "integer", "incoming": "integer", "link": "integer", "trial": "boolean",
        "bits": {"list": "integer"}, "order": {"list": "integer"}
      }
    },
    "Adaptation": {
      "record": {
        "blocked_stage": "integer", "incoming": "integer",
        "specifications": {"list": "specification"}
      }
    }
  },
  "bindings": {
    "last": {
      "from": "suffix", "select": "last", "type": "Row",
      "default": {"stage": -1, "best": [], "count": []}
    },
    "root": {"from": "suffix", "select": "one", "type": "Row", "where": "x['stage'] == 0"},
    "rows": {"from": "suffix", "select": "map", "type": "Row", "key": "x['stage']"},
    "trial": {
      "from": "route", "select": "last", "type": "Step", "where": "x['trial']",
      "default": {"stage": -1, "incoming": 0, "link": 0, "trial": true, "bits": [], "order": []}
    },
    "previous": {
      "from": "route", "select": "last", "type": "Step", "where": "not x['trial']",
      "default": {"stage": -1, "incoming": 0, "link": 0, "trial": false, "bits": [], "order": []}
    },
    "made": {"from": "adapt", "select": "count"}
  },
  "expect": {
    "events": 21,
    "states": {"route": "wait", "adapt": "wait", "suffix": "wait"},
    "values": {
      "suffix": [
        {"stage": 5, "best": [1, -1], "count": [1, 0]},
        {"stage": 4, "best": [1, -1], "count": [1, 0]},
        {"stage": 3, "best": [1, 1], "count": [1, 1]},
        {"stage": 2, "best": [2, 1], "count": [2, 1]},
        {"stage": 1, "best": [2, -1], "count": [3, 0]},
        {"stage": 0, "best": [2, 2], "count": [3, 3]}
      ],
      "route": [
        {"stage": 0, "incoming": 0, "link": 1, "trial": true, "bits": [0, 0, 0, 1], "order": [3, 1, 2, 4]},
        {"stage": 0, "incoming": 0, "link": 0, "trial": false, "bits": [0, 1, 0, 0], "order": [3, 1, 2, 4]},
        {"stage": 1, "incoming": 0, "link": 1, "trial": false, "bits": [0, 0, 0, 1], "order": [1, 3, 2, 4]},
        {"stage": 2, "incoming": 1, "link": 0, "trial": false, "bits": [1, 0, 0, 0], "order": [3, 1, 2, 4]},
        {"stage": 3, "incoming": 0, "link": 0, "trial": false, "bits": [0, 1, 0, 0], "order": [3, 1, 2, 4]},
        {"stage": 4, "incoming": 0, "link": 0, "trial": false, "bits": [0, 1, 0, 0], "order": [1, 3, 2, 4]},
        {"stage": 5, "incoming": 0, "link": 1, "trial": false, "bits": [0, 0, 0, 1], "order": [3, 1, 2, 4]}
      ]
    }
  }
}
