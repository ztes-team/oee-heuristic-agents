        "specifications": {
          "list": "specification"
        }
      }
    },
    "Verdict": {
      "record": {
        "sat": "boolean",
        "model": {
          "list": "integer"
        }
      }
    }
  },
  "bindings": {
    "frame": {
      "from": "round",
      "select": "all",
      "window": 1,
      "type": "Frame",
      "note": "the latest frame, as a list of at most one (latest() reads it)"
    },
    "mine": {
      "from": "$self",
      "select": "all",
      "window": 1,
      "type": "Speech",
      "note": "the last speech of this clause"
    },
    "said": {
      "from": [
        "c1",
        "c2",
        "c3",
        "c4",
        "c5",
        "c6",
        "c7",
