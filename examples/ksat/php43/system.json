        "c20",
        "c21",
        "c22"
      ],
      "select": "map",
      "type": "Speech",
      "key": "[x['round'], x['clause']]",
      "note": "every speech by (round, clause); a learned clause extends the lineages read"
    },
    "decision": {
      "from": "decide",
      "select": "all",
      "window": 1,
      "type": "Decision"
    },
    "last_learned": {
      "from": "learn",
      "select": "all",
      "window": 1,
      "type": "Learned"
    },
    "learned": {
      "from": "learn",
      "select": "map",
      "type": "Learned",
      "key": "x['name']",
      "value": "x['literals']",
      "note": "name → literals of every learned clause, in the order of learning"
    },
    "learn_count": {
      "from": "learn",
      "select": "count"
    },
    "switches": {
      "from": "adapt",
      "select": "count"
    },
    "verdicts": {
      "from": "verdict",
      "select": "count"
    }
  },
